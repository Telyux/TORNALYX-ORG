{
  "name": "telyux/tornalyx",
  "description": "Tornalyx SGDM automated tests",
  "type": "project",
  "require": {"php": "^8.2", "ext-openssl": "*", "ext-pdo": "*"},
  "require-dev": {"phpunit/phpunit": "^10.5"},
  "autoload": {"classmap": ["SGDM/backend/shared/"]},
  "scripts": {"test": "phpunit --configuration phpunit.xml", "lint": "find SGDM -name '*.php' -print0 | xargs -0 -n1 php -l"}
}
