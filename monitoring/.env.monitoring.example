# Copy to .env.monitoring and replace all sample values before starting.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false
# Use a dedicated read-only MySQL monitoring user. Adapt host to the deployment.
DATA_SOURCE_NAME=monitor_user:REPLACE_PASSWORD@(host.docker.internal:3306)/
